  // adapter. Separated from the server tsconfig only because it needs the DOM
  // lib and no node types — the server has exactly the opposite need.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/client", "test/board-adapter.test.ts", "test/stream.test.ts"]
}
